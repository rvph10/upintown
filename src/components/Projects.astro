---
import SectionHeading from "./ui/SectionHeading.astro";
import Button from "./ui/Button.astro";
import ProjectCard, { type ProjectCardData } from "./ProjectCard.astro";

interface Props {
  label: string;
  title: string;
  all: { href: string; label: string };
  /** Shown in the empty image frame of a placeholder card. */
  placeholder: string;
  cards: ProjectCardData[];
}

const { label, title, all, placeholder, cards } = Astro.props;
---

<section aria-labelledby="projects-title" class="pb-24 sm:pb-32">
  <div data-reveal="sequence" class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
    <SectionHeading id="projects-title" label={label} title={title} align="start" reveal={false} />
    <Button href={all.href} tone="surface" class="flex-none" data-reveal-step>
      {all.label}
    </Button>
  </div>

  {/* The middle card is taller, so the row reads as a staggered gallery on large screens. */}
  <ul data-reveal="group" class="mt-16 grid gap-x-3 gap-y-12 sm:mt-20 md:grid-cols-2 lg:grid-cols-3 lg:items-start">
    {cards.map((card, index) => (
      <li>
        <ProjectCard card={card} tall={index % 3 === 1} placeholder={placeholder} />
      </li>
    ))}
  </ul>
</section>
