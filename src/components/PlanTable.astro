---
import Checkmark from "./icons/Checkmark.astro";
import Location from "./icons/Location.astro";
import Radar from "./icons/Radar.astro";
import Wrench from "./icons/Wrench.astro";
import Button from "./ui/Button.astro";
import Tooltip from "./ui/Tooltip.astro";
import { formatPrice, type Locale } from "../data/i18n";
import { featureGroups, planFeatures, plans, policies, type PlanId } from "../data/offer";
import { path } from "../data/routes";
import { ui } from "../data/ui";

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = {
  caption: { fr: "Comparaison des formules mensuelles", en: "Monthly plans compared" },
  feature: { fr: "Ce qui est compris", en: "What's included" },
  included: { fr: "Inclus", en: "Included" },
  notIncluded: { fr: "Non inclus", en: "Not included" },
  choose: { fr: "Choisir", en: "Choose" },
  moreAbout: { fr: "En savoir plus :", en: "More about:" },
  noSetup: { fr: "Sans frais de mise en place", en: "No setup fee" },
  setup: { fr: "de mise en place", en: "setup fee" },
  notice: {
    fr: `Mensuel, ${policies.noticeMonths} mois de préavis`,
    en: `Monthly, ${policies.noticeMonths} month's notice`,
  },
  minimum: { fr: (months: number) => `${months} mois minimum`, en: (months: number) => `${months} months minimum` },
};

const icons: Record<PlanId, typeof Wrench> = { essentiel: Wrench, visibilite: Location, croissance: Radar };
const groups = (Object.keys(featureGroups) as (keyof typeof featureGroups)[]).map((group) => ({
  label: featureGroups[group][locale],
  features: planFeatures.filter((feature) => feature.group === group),
}));
---

{/* Full comparison for wide screens: a card per plan with price and action, then features grouped by topic. */}
<div data-reveal class:list={["mt-16 sm:mt-20", className]}>
  <table class="w-full table-fixed text-left text-ink">
    <caption class="sr-only">{t.caption[locale]}</caption>
    <colgroup>
      <col class="w-[34%]" />
      {plans.map(() => (
        <col />
      ))}
    </colgroup>
    <thead>
      <tr class="align-top">
        <td>
          <span class="sr-only">{t.feature[locale]}</span>
        </td>
        {plans.map((plan) => {
          const Icon = icons[plan.id];
          return (
            <th scope="col" class="px-1.5 pb-4 font-normal">
              <span class="block rounded-card bg-paper p-6 inset-ring inset-ring-ash-200">
                <span class="grid size-12 place-items-center rounded-full bg-white">
                  <Icon class="size-6 text-ink" />
                </span>
                <span class="mt-8 block text-2xl font-medium tracking-title">{plan.name[locale]}</span>
                <span class="mt-1 block text-ash-600">{plan.job[locale]}</span>
                <span class="mt-6 flex items-baseline gap-1">
                  <span class="text-4xl font-semibold tracking-display">{formatPrice(plan.monthly, locale)}</span>
                  <span class="text-ash-600">{ui.perMonth[locale]}</span>
                </span>
                <span class="mt-3 block text-sm text-ash-600">
                  {plan.setupFee ? `${formatPrice(plan.setupFee, locale)} ${t.setup[locale]}` : t.noSetup[locale]}
                </span>
                <span class="block text-sm text-ash-600">
                  {plan.minimumMonths ? t.minimum[locale](plan.minimumMonths) : t.notice[locale]}
                </span>
                <Button href={`${path("contact", locale)}?plan=${plan.id}`} size="sm" full class="mt-6">
                  {`${t.choose[locale]} ${plan.name[locale]}`}
                </Button>
              </span>
            </th>
          );
        })}
      </tr>
    </thead>
    {groups.map((group) => (
      <tbody>
        <tr>
          <th
            scope="colgroup"
            colspan={plans.length + 1}
            class="pt-12 pb-4 text-xl font-semibold tracking-title text-ink"
          >
            {group.label}
          </th>
        </tr>
        {group.features.map((feature) => (
          <tr class="border-t border-ash-200">
            <th scope="row" class="py-4 pr-4 font-normal">
              <span class="flex items-center justify-between gap-3">
                {feature.label[locale]}
                {feature.details && (
                  <Tooltip label={`${t.moreAbout[locale]} ${feature.label[locale]}`} align="start" class="flex-none">
                    {feature.details[locale]}
                  </Tooltip>
                )}
              </span>
            </th>
            {plans.map((plan) => {
              const value = feature.plans[plan.id];
              return (
                <td class="px-7.5 py-4">
                  {value === true ? (
                    <>
                      <Checkmark class="size-6 text-volt [--check:var(--color-paper)]" />
                      <span class="sr-only">{t.included[locale]}</span>
                    </>
                  ) : value ? (
                    <span class="font-medium">{value[locale]}</span>
                  ) : (
                    <>
                      <span class="ml-1.5 block h-0.5 w-3 rounded-full bg-ash-300" aria-hidden="true" />
                      <span class="sr-only">{t.notIncluded[locale]}</span>
                    </>
                  )}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    ))}
  </table>
</div>
