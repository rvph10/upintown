---
import Location from "./icons/Location.astro";
import Logo from "./Logo.astro";
import Star from "./icons/Star.astro";

interface Props {
  /** What the customer types, e.g. "kiné à domicile". */
  query: string;
  /** Name on the Google profile card. */
  name: string;
  /** Site address shown in the search results. */
  address: string;
  /** Pill shown once a review gets its reply. */
  replied: string;
}

const { query, name, address, replied } = Astro.props;

// Other businesses on the map, as left/top percentages. This one's pin sits left of center, clear of the profile card.
const otherPins = [
  [10, 22],
  [62, 18],
  [84, 66],
];
---

<!-- Decorative mock: a customer searches, the business shows up on the map with its profile and reviews,
     and its website appears in the results below. No ranking is implied. -->
<div data-seo class="flex h-full w-full items-center justify-center px-6 py-12" aria-hidden="true">
  <div class="relative w-full max-w-64 sm:-translate-x-10 sm:scale-110 xl:scale-125">
    <div class="rounded-2xl bg-white p-4 shadow-sm">
      <div class="flex items-center gap-2 rounded-full bg-paper px-3 py-2 text-sm">
        <span class="size-3.5 flex-none rounded-full ring-2 ring-ash-400 ring-inset"></span>
        <span class="seo-query truncate text-ink">{query}</span>
        <span class="seo-caret -ml-1.5 inline-block h-4 w-0.5 flex-none rounded-full bg-iris-strong"></span>
      </div>

      {/* A simple map: two streets, a few businesses, then this one. */}
      <div class="relative mt-3 h-28 overflow-hidden rounded-xl bg-paper">
        <span class="absolute inset-x-0 top-1/2 h-2 -translate-y-1/2 -rotate-6 bg-white"></span>
        <span class="absolute inset-y-0 left-[45%] w-2 rotate-12 bg-white"></span>
        {otherPins.map(([left, top]) => (
          <Location class="seo-pin absolute size-4 text-ash-400" style={`left: ${left}%; top: ${top}%`} />
        ))}
        <span class="seo-main absolute top-[42%] left-[34%] grid -translate-x-1/2 -translate-y-1/2 place-items-center">
          <span class="seo-halo absolute size-6 rounded-full bg-iris/40"></span>
          <Location class="relative size-7 text-iris-strong" />
        </span>
      </div>

      <div class="mt-3 grid gap-1.5">
        <div class="relative rounded-lg px-2 py-1.5">
          <span class="seo-result absolute inset-0 rounded-lg bg-volt-soft"></span>
          <p class="relative flex items-center gap-1.5 text-xs text-ash-600">
            <span class="size-3 flex-none rounded-full bg-blush"></span>
            {address}
          </p>
          <span class="relative mt-1.5 block h-2 w-4/5 rounded-full bg-ink/80"></span>
          <span class="relative mt-1 block h-1.5 w-full rounded-full bg-ash-200"></span>
        </div>
        <div class="px-2 py-1.5">
          <span class="block h-1.5 w-1/3 rounded-full bg-ash-200"></span>
          <span class="mt-1.5 block h-2 w-2/3 rounded-full bg-ash-300"></span>
          <span class="mt-1 block h-1.5 w-11/12 rounded-full bg-ash-200"></span>
        </div>
      </div>
    </div>

    {/* The Google profile card opens over the right edge of the map, next to the pin. */}
    <div class="seo-profile absolute top-14 -right-4 w-40 rounded-2xl bg-white p-3.5 shadow-md sm:-right-28 sm:w-44">
      <p class="text-sm leading-tight font-semibold text-ink">{name}</p>
      <p class="mt-1.5 flex gap-0.5">
        {Array.from({ length: 5 }, () => (
          <Star class="seo-star size-3.5 text-sun" />
        ))}
      </p>
      <div class="mt-3 grid gap-1">
        <span class="h-1.5 w-full rounded-full bg-ash-200"></span>
        <span class="h-1.5 w-2/3 rounded-full bg-ash-200"></span>
      </div>
      <span class="seo-replied mt-3 flex w-fit items-center gap-1.5 rounded-full bg-paper py-1 pr-2.5 pl-1 text-xs font-medium whitespace-nowrap text-ink">
        <span class="grid size-5 place-items-center rounded-full bg-ink text-white">
          <Logo class="size-2.5" />
        </span>
        {replied}
      </span>
    </div>
  </div>
</div>

<style>
  /* Static frame, shown with reduced motion: the business is on the map, reviewed, and in the results. */
  .seo-caret,
  .seo-halo {
    opacity: 0;
  }
</style>

<script>
  import { gsap, playWhileVisible, withMotion } from "../lib/motion";

  // One 10s loop: the search types itself, the other businesses appear, this one's pin drops and pulses,
  // its profile opens with stars and a replied review, then its site lights up in the results.
  withMotion(() => {
    document.querySelectorAll<HTMLElement>("[data-seo]").forEach((root) => {
      const q = gsap.utils.selector(root);
      const loop = gsap.timeline({ repeat: -1, defaults: { ease: "curtain" } });

      loop
        .set(q(".seo-query"), { clipPath: "inset(0% 100% 0% 0%)", opacity: 1 }, 0)
        .set(q(".seo-caret"), { opacity: 1 }, 0)
        .set(q(".seo-pin"), { opacity: 0, scale: 0.6 }, 0)
        .set(q(".seo-main"), { opacity: 0, y: "-1rem" }, 0)
        .set(q(".seo-profile"), { opacity: 0, y: "0.75rem", scale: 0.96 }, 0)
        .set(q(".seo-star"), { opacity: 0, scale: 0.5 }, 0)
        .set(q(".seo-replied"), { opacity: 0, y: "0.25rem" }, 0)
        .set(q(".seo-result"), { opacity: 0 }, 0)
        // The search is typed.
        .to(q(".seo-query"), { clipPath: "inset(0% 0% 0% 0%)", duration: 1.2, ease: "steps(16)" }, 0.3)
        .to(q(".seo-caret"), { opacity: 0, duration: 0.1, ease: "none" }, 1.8)
        // The map fills, then this business drops in.
        .to(q(".seo-pin"), { opacity: 1, scale: 1, duration: 0.5, ease: "out-expo", stagger: 0.12 }, 1.8)
        .to(q(".seo-main"), { opacity: 1, y: 0, duration: 0.7, ease: "out-expo" }, 2.4)
        // Its profile opens, the stars fill, the review gets its reply.
        .to(q(".seo-profile"), { opacity: 1, y: 0, scale: 1, duration: 0.7, ease: "out-expo" }, 3)
        .to(q(".seo-star"), { opacity: 1, scale: 1, duration: 0.4, ease: "out-expo", stagger: 0.08 }, 3.4)
        .to(q(".seo-replied"), { opacity: 1, y: 0, duration: 0.5, ease: "out-expo" }, 4.4)
        // Its website lights up in the results.
        .to(q(".seo-result"), { opacity: 1, duration: 0.6 }, 5.4)
        // Everything clears before the loop restarts.
        .to(q(".seo-profile"), { opacity: 0, y: "0.5rem", duration: 0.6, ease: "out-expo" }, 8.6)
        .to(q(".seo-main, .seo-pin, .seo-result"), { opacity: 0, duration: 0.6, ease: "out-expo" }, 8.8)
        .to(q(".seo-query"), { opacity: 0, duration: 0.4 }, 9)
        .set({}, {}, 10);

      const pulse = gsap.fromTo(
        q(".seo-halo"),
        { opacity: 0.8, scale: 1 },
        { opacity: 0, scale: 2.5, duration: 1.6, ease: "out-expo", repeat: -1 },
      );

      playWhileVisible(root, loop);
      playWhileVisible(root, pulse);
    });
  });
</script>
