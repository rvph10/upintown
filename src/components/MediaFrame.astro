---
import type { HTMLAttributes } from "astro/types";
import ShaderBackground from "./ShaderBackground.astro";

type Props = HTMLAttributes<"div"> & {
  /** Shown instead of the slot until the real visual exists. */
  placeholder?: string;
};

const { placeholder, class: className, ...rest } = Astro.props;
---

{/* Shader-backed frame for a visual: a mock, a video card or a placeholder. */}
<div
  class:list={[
    "relative isolate grid min-h-80 place-items-center overflow-hidden rounded-3xl bg-paper sm:min-h-96",
    className,
  ]}
  {...rest}
>
  <ShaderBackground fadeTo="transparent" class="absolute inset-0 -z-10" />
  {placeholder ? (
    <span class="max-w-xs p-6 text-center text-ui font-medium text-ash-600" aria-hidden="true">
      {placeholder}
    </span>
  ) : (
    <slot />
  )}
</div>
