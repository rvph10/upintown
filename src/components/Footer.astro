---
import Logo from './Logo.astro';
import { business, contactLinks } from '../data/business';
import type { Locale } from '../data/i18n';
import { services } from '../data/offer';
import { path } from '../data/routes';
import { pageNames, ui } from '../data/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const link = 'text-ash-600 transition-colors hover:text-ink';
---

<footer class="page pt-24 pb-8">
  <div class="card grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div class="flex flex-col gap-4">
      <a href={path('home', locale)} class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight">
        <Logo class="h-6 w-auto" />
        {business.name}
      </a>
      <a href={path('contact', locale)} class="btn-accent self-start">{ui.requestQuote[locale]}</a>
    </div>

    <div>
      <h2 class="mb-3 font-sans text-sm font-medium text-ink">{pageNames.services[locale]}</h2>
      <ul class="flex flex-col gap-2">
        {services.map((service) => <li><a class={link} href={path(service.route, locale)}>{service.name[locale]}</a></li>)}
      </ul>
    </div>

    <address class="not-italic">
      <h2 class="mb-3 font-sans text-sm font-medium text-ink">{pageNames.contact[locale]}</h2>
      <ul class="flex flex-col gap-2">
        <li><a class={link} href={contactLinks.email}>{business.email}</a></li>
        <li><a class={link} href={contactLinks.phone}>{business.phone.display}</a></li>
        <li><a class={link} href={contactLinks.whatsapp}>{ui.whatsapp[locale]}</a></li>
      </ul>
    </address>

    <div>
      <h2 class="mb-3 font-sans text-sm font-medium text-ink">{ui.followUs[locale]}</h2>
      <ul class="flex flex-col gap-2">
        <li><a class={link} href={business.social.instagram} rel="me">Instagram</a></li>
        <li><a class={link} href={business.social.linkedin} rel="me">LinkedIn</a></li>
        <li><a class={link} href={business.social.github} rel="me">GitHub</a></li>
      </ul>
    </div>
  </div>

  <div class="mt-6 flex flex-col gap-3 px-2 text-sm text-ash-600 sm:flex-row sm:justify-between">
    <p>© {year} {business.name}</p>
    <ul class="flex gap-5">
      <li><a class={link} href={path('legalNotice', locale)}>{pageNames.legalNotice[locale]}</a></li>
      <li><a class={link} href={path('privacy', locale)}>{pageNames.privacy[locale]}</a></li>
    </ul>
  </div>
</footer>
