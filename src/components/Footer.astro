---
import { business, contactLinks } from "../data/business";
import type { Locale } from "../data/i18n";
import { descriptions } from "../data/meta";
import { services } from "../data/offer";
import { path } from "../data/routes";
import { pageNames, ui } from "../data/ui";
import ArrowUpRight from "./icons/ArrowUpRight.astro";
import Email from "./icons/Email.astro";
import Instagram from "./icons/Instagram.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import Phone from "./icons/Phone.astro";
import WhatsApp from "./icons/WhatsApp.astro";
import Logo from "./Logo.astro";
import RollText from "./ui/RollText.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();

const text = {
  explore: { fr: "Explorer", en: "Explore" },
  backToTop: { fr: "Retour en haut", en: "Back to top" },
};

const columns = [
  {
    id: "footer-services",
    title: pageNames.services[locale],
    links: services.map((service) => ({ href: path(service.route, locale), label: service.name[locale] })),
  },
  {
    id: "footer-explore",
    title: text.explore[locale],
    links: (["projects", "pricing", "blog", "contact"] as const).map((route) => ({
      href: path(route, locale),
      label: pageNames[route][locale],
    })),
  },
];

const contacts = [
  { href: contactLinks.email, label: ui.email[locale], value: business.email, icon: Email },
  { href: contactLinks.phone, label: ui.phone[locale], value: business.phone.display, icon: Phone },
];

const socials = [
  { href: contactLinks.whatsapp, label: ui.whatsapp[locale], icon: WhatsApp },
  { href: business.social.instagram, label: "Instagram", icon: Instagram, rel: "me" },
  { href: business.social.linkedin, label: "LinkedIn", icon: LinkedIn, rel: "me" },
];

const legalLinks = (["legalNotice", "privacy", "terms"] as const).map((route) => ({
  href: path(route, locale),
  label: pageNames[route][locale],
}));

// Stacked copies of the mark give it depth in the decorative tile.
const depth = Array.from({ length: 14 }, (_, i) => i);

const focus = "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-strong";
const iconButton = `grid size-11 flex-none place-items-center rounded-full transition-colors duration-300 motion-reduce:transition-none ${focus}`;
---

<footer class="site-width pb-3 sm:pb-4">
  <div class="rounded-card bg-paper p-2 sm:p-3">
    <div class="grid gap-2 sm:gap-3 lg:grid-cols-[minmax(0,5fr)_minmax(0,4fr)_minmax(0,3fr)]">
      <div class="flex flex-col rounded-3xl bg-surface p-6 sm:p-8 lg:p-10">
        <a
          href={path("home", locale)}
          class={`flex items-center gap-[0.4em] self-start rounded-lg text-2xl font-semibold tracking-title text-ink ${focus}`}
        >
          <Logo class="size-[1.15em]" />
          {business.name}
        </a>
        <p class="mt-6 max-w-sm leading-relaxed text-pretty text-ash-600">{descriptions.home[locale]}</p>

        <div class="mt-8 lg:mt-auto lg:pt-8">
          <ul class="flex gap-2" aria-label={ui.followUs[locale]}>
            {socials.map(({ href, label, icon: Icon, rel }) => (
              <li>
                <a
                  href={href}
                  rel={rel}
                  aria-label={label}
                  class={`${iconButton} bg-paper text-ink hover:bg-ink hover:text-white`}
                >
                  <Icon class="size-5" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="flex flex-col gap-8 p-4 sm:p-8 lg:py-10">
        <div class="grid grid-cols-2 gap-x-6 gap-y-8">
          {columns.map((column) => (
            <nav aria-labelledby={column.id}>
              <p id={column.id} class="text-lg font-semibold tracking-title text-ink">
                {column.title}
              </p>
              <ul class="mt-3 grid gap-2">
                {column.links.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class={`group inline-block rounded-md text-ui text-ash-600 transition-colors duration-300 hover:text-ink motion-reduce:transition-none ${focus}`}
                    >
                      <RollText>{item.label}</RollText>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))}
        </div>

        <ul class="-mx-3 mt-auto grid gap-1">
          {contacts.map(({ href, label, value, icon: Icon }) => (
            <li>
              <a
                href={href}
                class={`group flex items-center gap-4 rounded-2xl p-3 transition-colors duration-300 hover:bg-white motion-reduce:transition-none ${focus}`}
              >
                <span class="grid size-11 flex-none place-items-center rounded-full bg-white text-ink transition-colors duration-300 group-hocus:bg-paper motion-reduce:transition-none">
                  <Icon class="size-5" />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm text-ash-600">{label}</span>
                  <span class="block text-ui font-semibold [overflow-wrap:anywhere] text-ink">{value}</span>
                </span>
                <ArrowUpRight class="ml-auto size-4 flex-none text-ink opacity-0 transition-opacity duration-300 group-hocus:opacity-100 motion-reduce:transition-none" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div
        class="relative isolate grid min-h-60 place-items-center overflow-hidden rounded-3xl"
        style="background: radial-gradient(circle at 15% 10%, var(--color-sky) 0, transparent 55%), radial-gradient(circle at 90% 25%, var(--color-blush) 0, transparent 50%), radial-gradient(circle at 55% 105%, var(--color-sun) 0, transparent 45%), var(--color-iris);"
        aria-hidden="true"
      >
        <span class="absolute top-[62%] -z-10 h-8 w-36 rounded-full bg-ink/30 blur-2xl"></span>
        <div class="perspective-[60rem]">
          <div class="relative size-36 transform-3d [transform:rotateX(18deg)_rotateY(-30deg)_rotateZ(-6deg)]">
            {depth.map((i) => (
              <span class="absolute inset-0" style={`transform: translateZ(${i * 1.5}px)`}>
                <Logo class={i === depth.length - 1 ? "size-full text-white" : "size-full text-mist"} />
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-2 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 rounded-3xl bg-surface py-3 pr-3 pl-6 text-sm sm:py-2 sm:pr-2 text-ash-600 sm:mt-3 sm:rounded-full">
      <p>
        &copy; {year} {business.name}
      </p>
      <div class="flex items-center gap-6">
        <ul class="flex flex-wrap gap-x-6 gap-y-1">
          {legalLinks.map((item) => (
            <li>
              <a href={item.href} class={`rounded-md underline-offset-4 hover:text-ink hover:underline ${focus}`}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <a href="#" class={`${iconButton} bg-paper text-ink hover:bg-ink hover:text-white`}>
          <ArrowUpRight class="size-4 -rotate-45" />
          <span class="sr-only">{text.backToTop[locale]}</span>
        </a>
      </div>
    </div>
  </div>
</footer>
