---
import type { HTMLAttributes } from "astro/types";
import { controlSizes, type ControlSize } from "./sizes";
import ArrowUpRight from "../icons/ArrowUpRight.astro";
import RollText from "./RollText.astro";

type Props = Omit<HTMLAttributes<"a"> & HTMLAttributes<"button">, "type"> & {
  href?: string;
  type?: "button" | "submit" | "reset";
  tone?: "ink" | "surface";
  size?: ControlSize;
  icon?: boolean;
  full?: boolean;
  disabled?: boolean;
};

const {
  href,
  type = "button",
  tone = "ink",
  size = "md",
  icon = true,
  full = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
const label = await Astro.slots.render("default");

const tones = {
  ink: "bg-ink text-paper",
  surface: "bg-surface text-ink inset-ring inset-ring-ash-200",
};

const sizes = controlSizes;

// The fill grows from the icon circle, or from the bottom edge without an icon.
const fill = icon
  ? "[clip-path:inset(var(--gap)_var(--gap)_var(--gap)_calc(100%-var(--gap)-var(--dot))_round_9999px)] group-hocus:[clip-path:inset(var(--gap)_round_9999px)]"
  : "[clip-path:circle(0_at_50%_100%)] group-hocus:[clip-path:circle(150%_at_50%_100%)]";

const motion = "transition-transform duration-500 ease-curtain motion-reduce:transition-none";
---

<Tag
  class:list={[
    "group relative isolate inline-flex h-(--h) cursor-pointer items-center gap-4 overflow-hidden rounded-full font-semibold tracking-ui whitespace-nowrap",
    "transition-transform duration-200 not-disabled:active:scale-98 motion-reduce:transition-none",
    "focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-iris-strong",
    "disabled:cursor-not-allowed disabled:opacity-45",
    tones[tone],
    sizes[size].root,
    icon ? ["[--gap:calc((var(--h)-var(--dot))/2)] pr-(--gap)", sizes[size].start] : sizes[size].padding,
    full && "w-full",
    full && icon ? "justify-between" : "justify-center",
    className,
  ]}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  {...rest}
>
  <span
    class:list={[
      "absolute inset-0 -z-10 bg-white transition-[clip-path] duration-500 ease-curtain motion-reduce:transition-none",
      fill,
    ]}
    aria-hidden="true"
  ></span>
  <RollText rollClass="text-ink">
    <Fragment set:html={label} />
  </RollText>
  {icon && (
    <span class="grid size-(--dot) flex-none place-items-center text-ink" aria-hidden="true">
      <span class:list={["relative overflow-hidden", sizes[size].icon]}>
        <ArrowUpRight
          class:list={[
            "absolute inset-0 size-full group-hocus:translate-x-[110%] group-hocus:-translate-y-[110%]",
            motion,
          ]}
        />
        <ArrowUpRight
          class:list={[
            "absolute inset-0 size-full -translate-x-[110%] translate-y-[110%] group-hocus:translate-x-0 group-hocus:translate-y-0",
            motion,
          ]}
        />
      </span>
    </span>
  )}
</Tag>
