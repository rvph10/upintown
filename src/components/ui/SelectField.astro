---
import type { HTMLAttributes } from "astro/types";
import FieldLabel from "./FieldLabel.astro";
import FieldMessage from "./FieldMessage.astro";

type Props = Omit<HTMLAttributes<"select">, "id" | "name" | "value"> & {
  id: string;
  name?: string;
  label: string;
  options: { value: string; label: string }[];
  value?: string;
  hint?: string;
  error?: string;
};

const {
  id,
  name = id,
  label,
  options,
  value = "",
  hint,
  error,
  required,
  disabled,
  class: className,
  ...rest
} = Astro.props;

const describedBy = [error && `${id}-error`, hint && `${id}-hint`].filter(Boolean).join(" ") || undefined;
const selected = options.find((option) => option.value === value) ?? options[0];
const ring = error
  ? "inset-ring-2 inset-ring-danger"
  : "inset-ring inset-ring-ash-200 enabled:not-focus:hover:inset-ring-ash-400 focus:inset-ring-2 focus:inset-ring-iris-strong";
const control = [
  "block h-14 w-full cursor-pointer appearance-none rounded-full bg-surface pr-14 pl-6 text-left text-base text-ink outline-none transition-shadow duration-200",
  "disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none",
  ring,
].join(" ");
---

{/* Same look as TextField. Without JavaScript the native select is used; the script swaps in a styled list (select-only
    combobox pattern) and keeps the native select in sync for the form. */}
<div data-select class:list={["grid gap-2.5", className]}>
  <FieldLabel for={id} id={`${id}-label`} required={Boolean(required)} error={Boolean(error)}>
    {label}
  </FieldLabel>
  <div class="relative">
    <select
      id={id}
      name={name}
      required={required}
      disabled={disabled}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={describedBy}
      data-select-native
      class={control}
      {...rest}
    >
      {options.map((option) => (
        <option value={option.value} selected={option === selected}>
          {option.label}
        </option>
      ))}
    </select>
    <button
      type="button"
      id={`${id}-button`}
      role="combobox"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-controls={`${id}-list`}
      aria-labelledby={`${id}-label ${id}-button`}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={describedBy}
      disabled={disabled}
      hidden
      data-select-button
      class={control}
    >
      <span data-select-value class="block truncate">
        {selected?.label}
      </span>
    </button>
    <svg
      class="pointer-events-none absolute top-7 right-6 size-3 -translate-y-1/2 text-ink transition-transform duration-300 ease-curtain motion-reduce:transition-none [[aria-expanded=true]~&]:rotate-180"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M2.2045 6.7045C2.64384 6.26517 3.35616 6.26517 3.7955 6.7045L12 14.909L20.2045 6.70451C20.6438 6.26517 21.3562 6.26517 21.7955 6.70451C22.2348 7.14385 22.2348 7.85616 21.7955 8.2955L12.7955 17.2955C12.3562 17.7348 11.6438 17.7348 11.2045 17.2955L2.2045 8.2955C1.76517 7.85616 1.76517 7.14384 2.2045 6.7045Z"
      />
    </svg>
    <ul
      id={`${id}-list`}
      role="listbox"
      aria-labelledby={`${id}-label`}
      tabindex="-1"
      hidden
      data-select-list
      data-lenis-prevent
      class="absolute inset-x-0 top-full z-30 mt-2 grid max-h-72 gap-1 overflow-y-auto rounded-3xl bg-surface p-2 shadow-xl shadow-ink/10 inset-ring inset-ring-ash-200 transition-[opacity,translate] duration-200 ease-out-expo starting:-translate-y-1 starting:opacity-0 motion-reduce:transition-none"
    >
      {options.map((option, index) => (
        <li
          id={`${id}-option-${index}`}
          role="option"
          aria-selected={option === selected ? "true" : "false"}
          data-value={option.value}
          data-label={option.label}
          class="group flex cursor-pointer items-center justify-between gap-4 rounded-2xl px-4 py-3 text-base text-ink transition-colors duration-200 select-none data-active:bg-paper motion-reduce:transition-none"
        >
          {option.label}
          <svg
            class="size-4 flex-none text-ink opacity-0 group-aria-selected:opacity-100"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </li>
      ))}
    </ul>
  </div>
  {error && (
    <FieldMessage id={`${id}-error`} tone="error">
      {error}
    </FieldMessage>
  )}
  {hint && (
    <FieldMessage id={`${id}-hint`} tone="hint">
      {hint}
    </FieldMessage>
  )}
</div>

<script>
  function init(root: HTMLElement) {
    const select = root.querySelector<HTMLSelectElement>("[data-select-native]")!;
    const button = root.querySelector<HTMLButtonElement>("[data-select-button]")!;
    const list = root.querySelector<HTMLUListElement>("[data-select-list]")!;
    const value = root.querySelector<HTMLElement>("[data-select-value]")!;
    const label = root.querySelector("label")!;
    const options = [...list.querySelectorAll<HTMLLIElement>("[role=option]")];
    let active = select.selectedIndex;

    select.hidden = true;
    button.hidden = false;
    label.htmlFor = button.id;

    const isOpen = () => button.getAttribute("aria-expanded") === "true";

    function setActive(index: number) {
      active = Math.max(0, Math.min(options.length - 1, index));
      options.forEach((option, i) => option.toggleAttribute("data-active", i === active));
      button.setAttribute("aria-activedescendant", options[active].id);
      // Scroll the list only, never the page.
      const { offsetTop, offsetHeight } = options[active];
      if (offsetTop < list.scrollTop) list.scrollTop = offsetTop;
      else if (offsetTop + offsetHeight > list.scrollTop + list.clientHeight)
        list.scrollTop = offsetTop + offsetHeight - list.clientHeight;
    }

    function open(index = select.selectedIndex) {
      list.hidden = false;
      button.setAttribute("aria-expanded", "true");
      setActive(index);
      document.addEventListener("pointerdown", onOutside);
    }

    function close() {
      list.hidden = true;
      button.setAttribute("aria-expanded", "false");
      button.removeAttribute("aria-activedescendant");
      document.removeEventListener("pointerdown", onOutside);
    }

    function choose(index: number) {
      select.selectedIndex = index;
      select.dispatchEvent(new Event("change", { bubbles: true }));
      value.textContent = options[index].dataset.label!;
      options.forEach((option, i) => option.setAttribute("aria-selected", String(i === index)));
      close();
      button.focus();
    }

    function onOutside(event: PointerEvent) {
      if (!root.contains(event.target as Node)) close();
    }

    button.addEventListener("click", () => (isOpen() ? close() : open()));

    button.addEventListener("keydown", (event) => {
      const { key } = event;
      if (!isOpen()) {
        if (["ArrowDown", "ArrowUp", "Enter", " ", "Home", "End"].includes(key)) {
          event.preventDefault();
          open(key === "Home" ? 0 : key === "End" ? options.length - 1 : select.selectedIndex);
        }
        return;
      }
      if (key === "ArrowDown" || key === "ArrowUp") {
        event.preventDefault();
        setActive(active + (key === "ArrowDown" ? 1 : -1));
      } else if (key === "Home" || key === "End") {
        event.preventDefault();
        setActive(key === "Home" ? 0 : options.length - 1);
      } else if (key === "Enter" || key === " ") {
        event.preventDefault();
        choose(active);
      } else if (key === "Escape") {
        event.preventDefault();
        close();
      } else if (key === "Tab") {
        choose(active);
      } else if (key.length === 1) {
        // Type-ahead: next option starting with the typed letter.
        const letter = key.toLocaleLowerCase();
        const order = [...options.slice(active + 1), ...options.slice(0, active + 1)];
        const match = order.find((option) => option.dataset.label!.toLocaleLowerCase().startsWith(letter));
        if (match) setActive(options.indexOf(match));
      }
    });

    // Keep focus on the button while clicking an option.
    list.addEventListener("pointerdown", (event) => event.preventDefault());
    options.forEach((option, index) => {
      option.addEventListener("click", () => choose(index));
      option.addEventListener("pointermove", () => active !== index && setActive(index));
    });
  }

  document.querySelectorAll<HTMLElement>("[data-select]").forEach(init);
</script>
