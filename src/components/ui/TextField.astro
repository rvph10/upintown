---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'input'>, 'id' | 'name' | 'value'> & {
  id: string;
  name?: string;
  label: string;
  value?: string;
  hint?: string;
  error?: string;
  multiline?: boolean;
  rows?: number;
};

const {
  id,
  name = id,
  label,
  value = '',
  hint,
  error,
  multiline = false,
  rows = 5,
  placeholder,
  class: className,
  ...rest
} = Astro.props;

const describedBy = [error && `${id}-error`, hint && `${id}-hint`].filter(Boolean).join(' ') || undefined;
const shared: HTMLAttributes<'input'> & HTMLAttributes<'textarea'> = {
  id,
  name,
  class: 'field-control',
  // A non-empty placeholder is required for the floating label (:placeholder-shown).
  placeholder: placeholder || ' ',
  'aria-invalid': error ? true : undefined,
  'aria-describedby': describedBy,
};
---

<div class:list={['field', { 'field-multiline': multiline, 'field-invalid': error }, className]}>
  <div class="field-box">
    {
      multiline ? (
        <textarea {...shared} rows={rows} {...(rest as HTMLAttributes<'textarea'>)}>{value}</textarea>
      ) : (
        <input {...shared} value={value} {...rest} />
      )
    }
    <label for={id} class="field-label">{label}</label>
  </div>
  {
    error && (
      <p id={`${id}-error`} class="field-message field-error">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="7" fill="currentColor" />
          <path d="M8 4.5v4M8 11v.5" stroke="var(--color-surface)" stroke-width="1.75" stroke-linecap="round" />
        </svg>
        {error}
      </p>
    )
  }
  {hint && <p id={`${id}-hint`} class="field-message field-hint">{hint}</p>}
</div>

<style>
  .field {
    --h: 3.5rem;
    --pad: 1.5rem;
    --ring: var(--color-ash-200);
    --ring-width: 1px;
    --label-y: calc(var(--h) / 2);
    --float: 0.7rem;
    display: grid;
    gap: 0.5rem;
  }

  .field-box {
    position: relative;
  }

  .field-control {
    display: block;
    width: 100%;
    height: var(--h);
    padding: 1.375rem var(--pad) 0.375rem;
    border: 0;
    border-radius: 9999px;
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 var(--ring-width) var(--ring);
    font: inherit;
    font-size: 1rem;
    outline: none;
    transition: box-shadow 0.2s ease;
  }

  .field-multiline {
    --label-y: 2.5rem;
    --float: 1.3rem;
  }

  .field-multiline .field-control {
    height: auto;
    min-height: 8rem;
    padding-top: 1.75rem;
    padding-bottom: 1rem;
    border-radius: 1.75rem;
    line-height: 1.5;
    resize: vertical;
  }

  .field-control::placeholder {
    color: transparent;
    transition: color 0.2s ease;
  }

  .field-control:focus::placeholder {
    color: var(--color-ash-600);
  }

  .field-label {
    position: absolute;
    top: var(--label-y);
    left: var(--pad);
    max-width: calc(100% - var(--pad) * 2);
    overflow: hidden;
    color: var(--color-ash-600);
    font-size: 1rem;
    line-height: 1.25;
    white-space: nowrap;
    text-overflow: ellipsis;
    pointer-events: none;
    transform: translateY(-50%);
    transform-origin: left center;
    transition:
      transform 0.25s var(--ease-curtain),
      color 0.2s ease;
  }

  .field-control:focus + .field-label,
  .field-control:not(:placeholder-shown) + .field-label,
  .field-control:autofill + .field-label {
    transform: translateY(calc(-50% - var(--float))) scale(0.75);
  }

  .field-control:focus + .field-label {
    color: var(--color-iris-strong);
  }

  @media (hover: hover) {
    .field-control:hover:not(:focus, :disabled) {
      --ring: var(--color-ash-400);
    }
  }

  .field-control:focus {
    --ring: var(--color-iris-strong);
    --ring-width: 2px;
  }

  .field-invalid .field-control {
    --ring: var(--color-danger);
    --ring-width: 2px;
  }

  .field-invalid .field-label,
  .field-invalid .field-control:focus + .field-label {
    color: var(--color-danger);
  }

  .field-control:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .field-control:disabled + .field-label {
    opacity: 0.5;
  }

  .field-message {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding-inline: var(--pad);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .field-hint {
    color: var(--color-ash-600);
  }

  .field-error {
    color: var(--color-danger);
    font-weight: 500;
  }

  .field-error svg {
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .field-label,
    .field-control,
    .field-control::placeholder {
      transition-duration: 0.01ms;
    }
  }
</style>
