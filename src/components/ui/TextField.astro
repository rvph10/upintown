---
import type { HTMLAttributes } from "astro/types";
import FieldLabel from "./FieldLabel.astro";
import FieldMessage from "./FieldMessage.astro";

type Props = Omit<HTMLAttributes<"input">, "id" | "name" | "value"> & {
  id: string;
  name?: string;
  label: string;
  value?: string;
  hint?: string;
  error?: string;
  multiline?: boolean;
  rows?: number;
};

const {
  id,
  name = id,
  label,
  value = "",
  hint,
  error,
  multiline = false,
  rows = 5,
  placeholder,
  required,
  class: className,
  ...rest
} = Astro.props;

const describedBy = [error && `${id}-error`, hint && `${id}-hint`].filter(Boolean).join(" ") || undefined;
const ring = error
  ? "inset-ring-2 inset-ring-danger"
  : "inset-ring inset-ring-ash-200 enabled:not-focus:hover:inset-ring-ash-400 focus:inset-ring-2 focus:inset-ring-iris-strong";
const control = [
  "block w-full bg-surface px-6 text-base text-ink outline-none transition-shadow duration-200 placeholder:text-ash-600",
  "disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none",
  multiline ? "min-h-32 resize-y rounded-[1.75rem] py-4 leading-normal" : "h-14 rounded-full",
  ring,
].join(" ");

const shared: HTMLAttributes<"input"> & HTMLAttributes<"textarea"> = {
  id,
  name,
  class: control,
  placeholder,
  required,
  "aria-invalid": error ? true : undefined,
  "aria-describedby": describedBy,
};
---

<div class:list={["grid gap-2.5", className]}>
  <FieldLabel for={id} required={Boolean(required)} error={Boolean(error)}>
    {label}
  </FieldLabel>
  {multiline ? (
    <textarea {...shared} rows={rows} {...(rest as HTMLAttributes<"textarea">)}>{value}</textarea>
  ) : (
    <input {...shared} value={value} {...rest} />
  )}
  {error && (
    <FieldMessage id={`${id}-error`} tone="error">
      {error}
    </FieldMessage>
  )}
  {hint && (
    <FieldMessage id={`${id}-hint`} tone="hint">
      {hint}
    </FieldMessage>
  )}
</div>
