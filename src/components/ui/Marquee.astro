---
interface Props {
  /** Seconds for one full loop. */
  duration?: number;
  class?: string;
}

const { duration = 40, class: className } = Astro.props;
const items = await Astro.slots.render("default");
---

<div data-marquee data-duration={duration} class:list={["relative w-full", className]}>
  <div class="overflow-hidden mask-[linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]">
    <div data-marquee-track class="flex w-max">
      <ul class="marquee-list flex flex-none items-center" set:html={items} />
      <ul class="marquee-list flex flex-none items-center" aria-hidden="true" inert set:html={items} />
    </div>
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 left-0 w-[12%] backdrop-blur-sm mask-[linear-gradient(to_right,black,transparent)]"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 w-[12%] backdrop-blur-sm mask-[linear-gradient(to_left,black,transparent)]"
    aria-hidden="true"
  ></div>
</div>

<style>
  /* The gap is also added after the last item so both copies join seamlessly. */
  .marquee-list {
    gap: 1.25rem;
    padding-right: 1.25rem;
  }
</style>

<script>
  import { gsap, withMotion } from "../../lib/motion";

  // Moves one copy's width, then starts over on the identical second copy. Pauses on hover and focus.
  withMotion(() => {
    document.querySelectorAll<HTMLElement>("[data-marquee]").forEach((marquee) => {
      const tween = gsap.to(marquee.querySelector("[data-marquee-track]"), {
        xPercent: -50,
        duration: Number(marquee.dataset.duration),
        ease: "none",
        repeat: -1,
      });
      const hold = () => tween.pause();
      const release = () => {
        if (!marquee.matches(":hover, :focus-within")) tween.resume();
      };
      marquee.addEventListener("pointerenter", hold);
      marquee.addEventListener("focusin", hold);
      marquee.addEventListener("pointerleave", release);
      marquee.addEventListener("focusout", () => requestAnimationFrame(release));
    });
  });
</script>
