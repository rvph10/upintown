    fill="var(--check, var(--color-ink))"
    d="M17.4053 9.53033C17.6982 9.23744 17.6982 8.76256 17.4053 8.46967C17.1124 8.17678 16.6376 8.17678 16.3447 8.46967L10.5 14.3143L8.03033 11.8447C7.73744 11.5518 7.26256 11.5518 6.96967 11.8447C6.67678 12.1376 6.67678 12.6124 6.96967 12.9053L9.96967 15.9053C10.2626 16.1982 10.7374 16.1982 11.0303 15.9053L17.4053 9.53033Z"
