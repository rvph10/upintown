---
import type Desktop from "./icons/Desktop.astro";
import SectionHeading from "./ui/SectionHeading.astro";

interface Props {
  id: string;
  label: string;
  title: string;
  subtitle?: string;
  items: { Icon: typeof Desktop; title: string; text: string }[];
  /** Columns on large screens. */
  columns?: 2 | 3 | 4;
}

const { id, label, title, subtitle, items, columns = 3 } = Astro.props;

const grid = { 2: "md:grid-cols-2", 3: "md:grid-cols-2 lg:grid-cols-3", 4: "md:grid-cols-2 lg:grid-cols-4" };
---

{/* Icon cards under a section heading. Anything in the slot goes under the grid. */}
<section id={id} aria-labelledby={`${id}-title`} class="scroll-mt-28 py-12 sm:py-16">
  <SectionHeading id={`${id}-title`} label={label} title={title} subtitle={subtitle} />
  <ul data-reveal="group" class:list={["mt-16 grid gap-3 sm:mt-20", grid[columns]]}>
    {items.map(({ Icon, ...item }) => (
      <li class="flex flex-col rounded-card bg-paper p-7 inset-ring inset-ring-ash-200 sm:p-8">
        <span class="grid size-14 place-items-center rounded-full bg-white">
          <Icon class="size-7 text-ink" />
        </span>
        <h3 class="mt-10 text-2xl font-medium tracking-title text-balance text-ink">{item.title}</h3>
        <p class="mt-3 text-lg leading-relaxed text-pretty text-ash-600">{item.text}</p>
      </li>
    ))}
  </ul>
  <slot />
</section>
