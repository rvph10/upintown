---
import Logo from "./Logo.astro";
import Button from "./ui/Button.astro";
import { business } from "../data/business";
import { locales, type Locale, type Localized } from "../data/i18n";
import { path } from "../data/routes";
import { mainNav, pageNames, ui } from "../data/ui";

interface Props {
  locale: Locale;
  alternates: Partial<Localized>;
}

const { locale, alternates } = Astro.props;
const current = Astro.url.pathname;
const otherLocale = locales.find((l) => l !== locale)!;
const otherPath = alternates[otherLocale];
const menuLabel = { fr: "Menu", en: "Menu" };

const links = mainNav.map((route) => {
  const href = path(route, locale);
  return { href, label: pageNames[route][locale], current: current === href || current.startsWith(`${href}/`) };
});
---

<header
  data-header
  class="sticky top-0 z-50 transition-[background-color,box-shadow] duration-300 data-scrolled:bg-paper/85 data-scrolled:shadow-[0_1px_0_var(--color-ash-200)] data-scrolled:backdrop-blur-xl"
>
  <a
    href="#content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-10 focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-paper"
  >
    {ui.skipToContent[locale]}
  </a>
  <div class="site-width flex h-20 items-center justify-between gap-6">
    <a href={path("home", locale)} class="flex items-center gap-2.5 rounded-full text-xl font-semibold tracking-tight">
      <Logo class="h-7 w-auto" />
      <span>{business.name}</span>
    </a>

    <div class="flex items-center gap-3">
      <nav aria-label={ui.mainNavLabel[locale]} class="hidden md:block">
        <ul class="flex items-center gap-1 rounded-full bg-surface p-1.5 shadow-[inset_0_0_0_1px_var(--color-ash-200)]">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.current ? "page" : undefined}
                class="flex h-9 items-center rounded-full px-4 text-[0.9375rem] font-medium text-ash-800 transition-colors hover:bg-ash-100 hover:text-ink aria-[current=page]:bg-ash-100 aria-[current=page]:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))}
          {otherPath && (
            <li class="ml-1 border-l border-ash-200 pl-1">
              <a
                href={otherPath}
                hreflang={otherLocale}
                lang={otherLocale}
                aria-label={ui.languageName[otherLocale]}
                class="flex h-9 items-center rounded-full px-3 text-sm font-semibold text-ash-600 uppercase transition-colors hover:bg-ash-100 hover:text-ink"
              >
                {otherLocale}
              </a>
            </li>
          )}
        </ul>
      </nav>

      <div class="hidden sm:block">
        <Button href={path("contact", locale)}>{ui.requestQuote[locale]}</Button>
      </div>

      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-12 place-items-center rounded-full bg-surface shadow-[inset_0_0_0_1px_var(--color-ash-200)] md:hidden"
      >
        <span class="sr-only">{menuLabel[locale]}</span>
        <svg
          class="size-5"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path class="origin-center transition-transform duration-300" d="M3 7h14" />
          <path class="origin-center transition-transform duration-300" d="M3 13h14" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" data-menu hidden class="site-width pb-4 md:hidden">
    <div class="grid gap-1 rounded-3xl bg-surface p-3 shadow-[inset_0_0_0_1px_var(--color-ash-200)]">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={link.current ? "page" : undefined}
          class="flex h-12 items-center rounded-2xl px-4 text-lg font-medium hover:bg-ash-100 aria-[current=page]:bg-ash-100"
        >
          {link.label}
        </a>
      ))}
      {otherPath && (
        <a
          href={otherPath}
          hreflang={otherLocale}
          lang={otherLocale}
          class="flex h-12 items-center rounded-2xl px-4 font-medium text-ash-600 hover:bg-ash-100"
        >
          {ui.languageName[otherLocale]}
        </a>
      )}
      <div class="mt-2">
        <Button href={path("contact", locale)} size="lg" full>
          {ui.requestQuote[locale]}
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const button = header.querySelector<HTMLButtonElement>("[data-menu-button]")!;
  const menu = header.querySelector<HTMLElement>("[data-menu]")!;

  const updateScrolled = () => header.toggleAttribute("data-scrolled", window.scrollY > 8);
  updateScrolled();
  window.addEventListener("scroll", updateScrolled, { passive: true });

  const setOpen = (open: boolean) => {
    button.setAttribute("aria-expanded", String(open));
    menu.hidden = !open;
    header.toggleAttribute("data-menu-open", open);
  };

  button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !menu.hidden) {
      setOpen(false);
      button.focus();
    }
  });
  window.matchMedia("(width >= 48rem)").addEventListener("change", () => setOpen(false));
</script>

<style>
  [data-menu-open] {
    background-color: var(--color-paper);
  }

  path {
    transform-box: fill-box;
  }

  [aria-expanded="true"] path:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  [aria-expanded="true"] path:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }
</style>
