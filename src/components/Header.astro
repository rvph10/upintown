---
import { business } from '../data/business';
import { locales, type Locale, type Localized } from '../data/i18n';
import { path } from '../data/routes';
import { mainNav, pageNames, ui } from '../data/ui';

interface Props {
  locale: Locale;
  alternates: Partial<Localized>;
}

const { locale, alternates } = Astro.props;
const current = Astro.url.pathname;
const otherLocale = locales.find((l) => l !== locale)!;
const otherPath = alternates[otherLocale];
---

<header>
  <a href="#content">{ui.skipToContent[locale]}</a>
  <a href={path('home', locale)}>{business.name}</a>
  <nav aria-label={ui.mainNavLabel[locale]}>
    <ul>
      {
        mainNav.map((route) => {
          const href = path(route, locale);
          const isCurrent = current === href || current.startsWith(`${href}/`);
          return (
            <li>
              <a href={href} aria-current={isCurrent ? 'page' : undefined}>
                {pageNames[route][locale]}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
  {
    otherPath && (
      <a href={otherPath} hreflang={otherLocale} lang={otherLocale} aria-label={ui.otherLanguageLabel[locale]}>
        {ui.languageName[otherLocale]}
      </a>
    )
  }
  <a href={path('contact', locale)}>{ui.requestQuote[locale]}</a>
</header>
