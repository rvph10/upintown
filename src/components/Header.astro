---
import { Image } from "astro:assets";
import repairPhone from "../assets/projects/reparation-electromenager/phone.webp";
import rollinLaptop from "../assets/projects/rollin/laptop.webp";
import vireliaWebsite from "../assets/projects/virelia/website.webp";
import { business, contactLinks } from "../data/business";
import { formatPrice, locales, type Locale, type Localized } from "../data/i18n";
import { services, type ServiceId } from "../data/offer";
import { getProjects } from "../data/projects";
import { path } from "../data/routes";
import { mainNav, pageNames, ui } from "../data/ui";
import ArrowUpRight from "./icons/ArrowUpRight.astro";
import Desktop from "./icons/Desktop.astro";
import Location from "./icons/Location.astro";
import WhatsApp from "./icons/WhatsApp.astro";
import Wrench from "./icons/Wrench.astro";
import Button from "./ui/Button.astro";
import RollText from "./ui/RollText.astro";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
  /** Same page in each language; without a translation the switch leads to the other home page. */
  alternates: Partial<Localized>;
  /** Floats over the page so a full-width section can sit underneath. */
  overlay?: boolean;
}

const { locale, alternates, overlay = false } = Astro.props;
const otherLocale = locales.find((l) => l !== locale)!;
const languageSwitch = {
  href: alternates[otherLocale] ?? path("home", otherLocale),
  locale: otherLocale,
  label: ui.languageName[otherLocale],
};
const current = Astro.url.pathname;

const servicesMenu = {
  open: { fr: "Afficher les services", en: "Show services" },
};
const menuLabel = { fr: "Menu", en: "Menu" };
const whatsappLabel = { fr: "Écrire sur WhatsApp", en: "Message on WhatsApp" };

// Service links appear in both the desktop services menu and the mobile menu.
const serviceItem =
  "group flex items-center gap-4 rounded-2xl p-3 pr-4 transition-colors duration-300 hover:bg-paper focus-visible:bg-paper focus-visible:outline-2 focus-visible:outline-iris-strong motion-reduce:transition-none";
const serviceIcon =
  "grid size-11 flex-none place-items-center rounded-xl bg-paper transition-colors duration-300 group-hocus:bg-white motion-reduce:transition-none";
const panel = "h-0 overflow-hidden";

const serviceIcons = { website: Desktop, care: Wrench, google: Location };
// The desktop services menu shows each service with a real project, by file name.
const previews: Record<ServiceId, { project: string; image: ImageMetadata }> = {
  website: { project: "rollin", image: rollinLaptop },
  care: { project: "virelia", image: vireliaWebsite },
  google: { project: "reparation-electromenager", image: repairPhone },
};
const projects = await getProjects(locale);
const serviceLinks = services.map((service) => {
  const project = projects.find((entry) => entry.slug === previews[service.id].project);
  return {
    id: service.id,
    href: path(service.route, locale),
    name: service.name[locale],
    tagline: service.tagline[locale],
    price: `${ui.from[locale]} ${formatPrice(service.fromPrice, locale)}${service.monthly ? ui.perMonth[locale] : ""}`,
    image: previews[service.id].image,
    project: project?.data.title,
    Icon: serviceIcons[service.id],
  };
});

const links = mainNav.map(({ route, hash, label, wide }) => {
  const page = path(route, locale);
  return {
    route,
    wide,
    href: hash ? `${page}#${hash}` : page,
    label: (label ?? pageNames[route])[locale],
    // A section link never marks the current page.
    current: !hash && (current === page || current.startsWith(`${page}/`)),
  };
});
---

<!-- Sticky wrapper; with a full-width hero it takes no height so the page slides underneath. -->
<div class:list={["sticky top-0 z-50 flow-root", overlay && "h-0"]}>
  <header
    data-header
    class="group/header relative mx-auto my-4 w-[calc(100%-1.5rem)] max-w-max rounded-[1.875rem] bg-surface/80 backdrop-blur-lg p-2 transition-shadow duration-500 data-open:bg-surface/70 data-open:shadow-2xl data-open:shadow-ink/15 data-open:inset-ring data-open:inset-ring-ash-200 motion-reduce:transition-none"
  >
    <a
      href="#content"
      class="sr-only rounded-full bg-ink text-ui font-semibold whitespace-nowrap text-white focus:not-sr-only focus:absolute focus:px-5 focus:py-3 focus:top-full focus:left-0 focus:mt-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-strong"
    >
      {ui.skipToContent[locale]}
    </a>
    <div class="flex items-center justify-between gap-3 md:gap-10 lg:gap-36">
      <a href={path("home", locale)} class="flex flex-none items-center justify-center rounded-full pl-2">
        <Logo class="size-9 text-ink" />
        <span class="sr-only">{business.name}</span>
      </a>
      <nav class="max-md:hidden" aria-label={ui.mainNavLabel[locale]}>
        <ul class="flex gap-6 text-ui font-semibold whitespace-nowrap">
          {links.map((link) => (
            <li
              data-services={link.route === "services" ? "" : undefined}
              data-nav-item
              class:list={["flex items-center gap-1", link.wide && "max-xl:hidden"]}
            >
              <a href={link.href} aria-current={link.current ? "page" : undefined} class="group block text-ink">
                <RollText>{link.label}</RollText>
              </a>
              {link.route === "services" && (
                <button
                  type="button"
                  data-services-toggle
                  aria-expanded="false"
                  aria-controls="services-menu"
                  class="grid size-6 cursor-pointer place-items-center rounded-full focus-visible:outline-2 focus-visible:outline-iris-strong"
                >
                  <span class="sr-only">{servicesMenu.open[locale]}</span>
                  <svg data-chevron class="size-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path
                      fill-rule="evenodd"
                      d="M2.2045 6.7045C2.64384 6.26517 3.35616 6.26517 3.7955 6.7045L12 14.909L20.2045 6.70451C20.6438 6.26517 21.3562 6.26517 21.7955 6.70451C22.2348 7.14385 22.2348 7.85616 21.7955 8.2955L12.7955 17.2955C12.3562 17.7348 11.6438 17.7348 11.2045 17.2955L2.2045 8.2955C1.76517 7.85616 1.76517 7.14384 2.2045 6.7045Z"
                    />
                  </svg>
                </button>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <div class="flex flex-none items-center gap-2">
        {/* Styled like the nav links; on phones it moves into the menu. */}
        <a
          href={languageSwitch.href}
          hreflang={languageSwitch.locale}
          lang={languageSwitch.locale}
          aria-label={languageSwitch.label}
          data-language-switch
          class="group block px-3 text-ui font-semibold text-ink uppercase max-md:hidden"
        >
          <RollText>{languageSwitch.locale}</RollText>
        </a>
        <a
          href={contactLinks.whatsapp}
          aria-label={whatsappLabel[locale]}
          class="group relative isolate grid size-11 flex-none place-items-center overflow-hidden rounded-full bg-ink text-white transition-transform duration-200 active:scale-98 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-iris-strong motion-reduce:transition-none"
        >
          {/* Same hover as the buttons: a white fill wipes up from the bottom edge. */}
          <span
            class="absolute inset-0 -z-10 bg-white [clip-path:circle(0_at_50%_100%)] transition-[clip-path] duration-500 ease-curtain group-hocus:[clip-path:circle(150%_at_50%_100%)] motion-reduce:transition-none"
            aria-hidden="true"
          ></span>
          {/* The stroke thickens the filled logo. */}
          <WhatsApp class="size-6 stroke-current stroke-1 transition-colors duration-500 ease-curtain [stroke-linejoin:round] group-hocus:text-ink motion-reduce:transition-none" />
        </a>
        <Button href={path("contact", locale)} size="sm">
          {ui.headerCta[locale]}
        </Button>
        {/* Two bars that turn into a cross while the menu is open. */}
        <button
          type="button"
          data-mobile-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="flex size-11 cursor-pointer flex-col items-center justify-center gap-1 rounded-full bg-surface inset-ring inset-ring-ash-200 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-iris-strong md:hidden"
        >
          <span class="sr-only">{menuLabel[locale]}</span>
          <span data-bar class="h-0.5 w-4 rounded-full bg-ink" aria-hidden="true"></span>
          <span data-bar class="h-0.5 w-4 rounded-full bg-ink" aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <!-- Grows by --menu-h while the header's negative margin cancels it, so the menu overlays the page. -->
    <div id="services-menu" data-services-menu inert class:list={[panel, "w-0 min-w-full max-md:hidden"]}>
      <div class="grid gap-2 px-2 pt-4 pb-2 lg:grid-cols-[1fr_18rem]">
        <ul class="grid content-start gap-1">
          {serviceLinks.map((service) => (
            <li>
              <a href={service.href} data-service-link={service.id} class={serviceItem}>
                <span class={serviceIcon}>
                  <service.Icon class="size-5 text-ink" />
                </span>
                <span class="grid min-w-0 flex-1 gap-0.5">
                  <span class="text-ui font-semibold text-ink">{service.name}</span>
                  <span class="text-sm text-ash-600">{service.tagline}</span>
                </span>
                <ArrowUpRight class="size-4 flex-none -translate-x-1 max-sm:hidden text-ink opacity-0 transition duration-300 group-hocus:translate-x-0 group-hocus:opacity-100 motion-reduce:transition-none" />
              </a>
            </li>
          ))}
        </ul>
        {/* The hovered or focused service with one of its projects; the list carries the same links for everyone. */}
        <div class="relative overflow-hidden rounded-2xl bg-paper max-lg:hidden" aria-hidden="true">
          {serviceLinks.map((service, index) => (
            <figure
              data-service-preview={service.id}
              data-active={index === 0 ? "" : undefined}
              class="absolute inset-0 scale-[1.04] opacity-0 transition duration-500 ease-curtain data-active:scale-100 data-active:opacity-100 motion-reduce:transition-none"
            >
              <Image src={service.image} alt="" widths={[320, 640]} sizes="18rem" class="size-full object-cover" />
              <figcaption class="absolute inset-x-2 bottom-2 grid gap-0.5 rounded-xl bg-white/90 px-3 py-2 backdrop-blur-md">
                {service.project && <span class="truncate text-sm font-semibold text-ink">{service.project}</span>}
                <span class="text-sm text-ash-600">{service.price}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>

    <!-- Same overlay technique as the services menu; scrolls inside when taller than the screen. -->
    <div
      id="mobile-menu"
      data-mobile-menu
      data-lenis-prevent
      inert
      class:list={[panel, "group-data-[open=mobile]/header:overflow-y-auto md:hidden"]}
    >
      <nav class="px-2 pt-4 pb-2" aria-label={ui.mainNavLabel[locale]}>
        <ul class="grid gap-1 border-t border-ash-200 pt-3">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.current ? "page" : undefined}
                class="flex items-center justify-between gap-4 rounded-2xl px-3 py-3 text-2xl font-medium tracking-title text-ink transition-colors duration-300 hover:bg-paper focus-visible:bg-paper focus-visible:outline-2 focus-visible:outline-iris-strong aria-[current=page]:bg-paper motion-reduce:transition-none"
              >
                {link.label}
                <ArrowUpRight class="size-4 flex-none" />
              </a>
              {link.route === "services" && (
                <ul class="grid gap-1 pb-2">
                  {serviceLinks.map((service) => (
                    <li>
                      <a href={service.href} class={serviceItem}>
                        <span class={serviceIcon}>
                          <service.Icon class="size-5 text-ink" />
                        </span>
                        <span class="grid min-w-0 flex-1 gap-0.5">
                          <span class="text-ui font-semibold text-ink">{service.name}</span>
                          <span class="text-sm text-ash-600">{service.tagline}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
        <div class="mt-2 border-t border-ash-200 pt-3">
          <a
            href={languageSwitch.href}
            hreflang={languageSwitch.locale}
            lang={languageSwitch.locale}
            data-language-switch
            class="flex items-center justify-between gap-4 rounded-2xl px-3 py-3 text-ui font-semibold text-ink transition-colors duration-300 hover:bg-paper focus-visible:bg-paper focus-visible:outline-2 focus-visible:outline-iris-strong motion-reduce:transition-none"
          >
            {languageSwitch.label}
            <span class="text-ash-600 uppercase" aria-hidden="true">
              {languageSwitch.locale}
            </span>
          </a>
        </div>
      </nav>
    </div>
  </header>
</div>

<script>
  import { duration, gsap, reducedMotion } from "../lib/motion";

  type Menu = "services" | "mobile";

  const header = document.querySelector<HTMLElement>("[data-header]")!;

  // Switching language keeps the visitor where they were. Texts differ in length, so the position is saved as
  // the section at the top of the screen (same id in both languages) and how far into it, falling back to the
  // share of the whole page.
  const switchKey = "language-switch";
  const sections = () => [...document.querySelectorAll<HTMLElement>("main [aria-labelledby]")];
  const pageTop = (element: HTMLElement) => element.getBoundingClientRect().top + scrollY;
  const scrollable = () => Math.max(document.documentElement.scrollHeight - innerHeight, 1);

  try {
    const saved = sessionStorage.getItem(switchKey);
    sessionStorage.removeItem(switchKey);
    if (saved) {
      const { section, progress, page } = JSON.parse(saved);
      const target = sections().find((element) => element.getAttribute("aria-labelledby") === section);
      const top = target ? pageTop(target) + progress * target.offsetHeight : page * scrollable();
      window.scrollTo({ top, behavior: "instant" });
    }
  } catch {}

  header.querySelectorAll("[data-language-switch]").forEach((link) =>
    link.addEventListener("click", () => {
      const current = sections().find((element) => element.getBoundingClientRect().bottom > 0);
      const position = {
        section: current?.getAttribute("aria-labelledby"),
        progress: current ? (scrollY - pageTop(current)) / current.offsetHeight : 0,
        page: scrollY / scrollable(),
      };
      try {
        sessionStorage.setItem(switchKey, JSON.stringify(position));
      } catch {}
    }),
  );
  const menus = {
    services: {
      toggle: header.querySelector<HTMLButtonElement>("[data-services-toggle]")!,
      panel: header.querySelector<HTMLElement>("[data-services-menu]")!,
    },
    mobile: {
      toggle: header.querySelector<HTMLButtonElement>("[data-mobile-toggle]")!,
      panel: header.querySelector<HTMLElement>("[data-mobile-menu]")!,
    },
  };
  const chevron = header.querySelector("[data-chevron]");
  const [topBar, bottomBar] = header.querySelectorAll("[data-bar]");
  const desktop = matchMedia("(min-width: 48rem)");
  const marginBottom = parseFloat(getComputedStyle(header).marginBottom);
  let closeTimer: number | undefined;

  // With reduced motion every change is instant.
  const time = (seconds: number) => (reducedMotion.matches ? 0 : seconds);
  const openMenu = () => header.dataset.open as Menu | undefined;

  const setOpen = (open: Menu | null) => {
    clearTimeout(closeTimer);
    // The open panel grows while the header's negative margin cancels its height, so it overlays the page.
    // The mobile menu stops at the bottom of the screen and scrolls inside.
    let height = 0;
    const opening = open && open !== openMenu();
    if (open) {
      const { panel } = menus[open];
      const room = innerHeight - header.getBoundingClientRect().bottom - 16;
      height = open === "mobile" ? Math.min(panel.scrollHeight, room) : panel.scrollHeight;
      header.dataset.open = open;
    } else {
      delete header.dataset.open;
    }
    const move = { duration: time(duration.base), ease: "curtain" };
    gsap.to(header, { marginBottom: open ? -height : marginBottom, ...move });
    for (const [name, { toggle, panel }] of Object.entries(menus)) {
      toggle.setAttribute("aria-expanded", String(name === open));
      panel.inert = name !== open;
      gsap.to(panel, { height: name === open ? height : 0, ...move });
    }
    // Links arrive one after the other as the panel opens; closing takes them away with the panel.
    if (opening && !reducedMotion.matches) {
      gsap.fromTo(
        menus[open].panel.querySelectorAll("a"),
        { opacity: 0, y: 10 },
        { opacity: 1, y: 0, duration: duration.base, ease: "out-expo", stagger: 0.035, delay: 0.08 },
      );
    }
    // The chevron flips for the services menu; the two bars cross for the mobile one.
    gsap.to(chevron, { rotation: open === "services" ? 180 : 0, ...move });
    gsap.to(topBar, { y: open === "mobile" ? 3 : 0, rotation: open === "mobile" ? 45 : 0, ...move });
    gsap.to(bottomBar, { y: open === "mobile" ? -3 : 0, rotation: open === "mobile" ? -45 : 0, ...move });
  };

  // Hover opens on Services and closes on other nav items or when the pointer leaves the header.
  header.querySelectorAll<HTMLElement>("[data-nav-item]").forEach((item) => {
    item.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") setOpen(item.hasAttribute("data-services") ? "services" : null);
    });
  });
  header.addEventListener("pointerenter", () => clearTimeout(closeTimer));
  header.addEventListener("pointerleave", (event) => {
    if (event.pointerType === "mouse" && openMenu() === "services")
      closeTimer = window.setTimeout(() => setOpen(null), 150);
  });

  // With a mouse, hover has already opened the services menu, so a click keeps it open.
  menus.services.toggle.addEventListener("click", (event) => {
    const mouse = (event as PointerEvent).pointerType === "mouse";
    setOpen(mouse || openMenu() !== "services" ? "services" : null);
  });
  menus.mobile.toggle.addEventListener("click", () => setOpen(openMenu() === "mobile" ? null : "mobile"));

  // The preview follows the service under the pointer or the keyboard focus.
  const previews = menus.services.panel.querySelectorAll<HTMLElement>("[data-service-preview]");
  menus.services.panel.querySelectorAll<HTMLElement>("[data-service-link]").forEach((link) => {
    const show = () =>
      previews.forEach((preview) => {
        preview.toggleAttribute("data-active", preview.dataset.servicePreview === link.dataset.serviceLink);
      });
    link.addEventListener("pointerenter", show);
    link.addEventListener("focus", show);
  });
  header.addEventListener("focusout", (event) => {
    if (!header.contains(event.relatedTarget as Node | null)) setOpen(null);
  });
  // A tap outside closes the menu (mobile browsers do not always move focus on tap).
  document.addEventListener("click", (event) => {
    if (openMenu() && !header.contains(event.target as Node)) setOpen(null);
  });
  desktop.addEventListener("change", () => setOpen(null));
  // Hide while scrolling down, show on scroll up, near the top, or while the header is in use.
  // It leaves quickly and comes back softly.
  let hidden = false;
  const setHidden = (value: boolean) => {
    if (value === hidden) return;
    hidden = value;
    if (hidden) {
      gsap.to(header, { y: -(header.offsetHeight + 32), duration: time(0.4), ease: "in-quart" });
      gsap.to(header, { opacity: 0, duration: time(duration.quick), ease: "in-quart" });
    } else {
      gsap.to(header, { y: 0, duration: time(0.7), ease: "out-expo" });
      gsap.to(header, { opacity: 1, duration: time(duration.base), ease: "out-expo" });
    }
  };
  let lastY = window.scrollY;
  // Stays put for the first scroll steps (one wheel notch is about 100px).
  const hideAfter = 300;
  const minDelta = 6;
  window.addEventListener(
    "scroll",
    () => {
      const y = Math.max(window.scrollY, 0);
      if (Math.abs(y - lastY) < minDelta) return;
      const inUse = header.hasAttribute("data-open") || header.contains(document.activeElement);
      setHidden(y > lastY && y > hideAfter && !inUse);
      lastY = y;
    },
    { passive: true },
  );
  header.addEventListener("focusin", () => setHidden(false));
  document.addEventListener("keydown", (event) => {
    const open = openMenu();
    if (event.key === "Escape" && open) {
      setOpen(null);
      menus[open].toggle.focus();
    }
  });
</script>
