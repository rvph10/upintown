---
import { Image } from "astro:assets";
import ArrowUpRight from "./icons/ArrowUpRight.astro";
import type { Locale } from "../data/i18n";
import type { Project } from "../data/projects";
import { projectPath } from "../data/routes";

interface Props {
  project: Project;
  locale: Locale;
  /** Small line above the title, e.g. "Projet suivant". */
  label: string;
}

const { project, locale, label } = Astro.props;
---

{/* One project as a wide link: text on one side, cover on the other. */}
<nav aria-label={label} class="pb-24 sm:pb-32">
  <a
    href={projectPath(project.slug, locale)}
    data-reveal
    class="group grid items-center gap-2 rounded-card bg-paper p-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-iris-strong sm:gap-3 sm:p-3 md:grid-cols-2"
  >
    <div class="flex flex-col gap-10 p-6 sm:p-10">
      <span class="text-ui font-semibold text-ash-600">{label}</span>
      <span class="grid gap-1">
        <span class="text-3xl font-medium tracking-title text-ink sm:text-4xl">{project.data.title}</span>
        <span class="text-lg text-ash-600">{project.data.sector}</span>
      </span>
      <span
        class="grid size-14 place-items-center rounded-full bg-ink text-white transition-transform duration-500 ease-curtain group-hocus:rotate-45 motion-reduce:transition-none"
        aria-hidden="true"
      >
        <ArrowUpRight class="size-6" />
      </span>
    </div>
    <div class="overflow-hidden rounded-3xl">
      <Image
        src={project.data.cover}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 48rem) 50vw, 100vw"
        class="aspect-4/3 w-full object-cover transition-transform duration-500 ease-curtain group-hocus:scale-[1.04] motion-reduce:transition-none"
      />
    </div>
  </a>
</nav>
