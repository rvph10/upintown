---
import Project from "../../views/Project.astro";
import { getProjects, type Project as ProjectEntry } from "../../data/projects";

export async function getStaticPaths() {
  const projects = await getProjects("fr");
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: ProjectEntry };
---

<Project locale="fr" project={project} />
