---
import Post from "../../views/Post.astro";
import { getPosts, postRedirects, type Post as PostEntry } from "../../data/posts";

export async function getStaticPaths() {
  const posts = await getPosts("fr");
  return [...posts.map((post) => ({ params: { slug: post.slug }, props: { post } })), ...(await postRedirects("fr"))];
}

const { post, redirect } = Astro.props as { post?: PostEntry; redirect?: string };
if (redirect) return Astro.redirect(redirect, 301);
---

<Post locale="fr" post={post!} />
