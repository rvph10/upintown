---
import { Font } from "astro:assets";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { umami } from "../data/analytics";
import { business } from "../data/business";
import { ui } from "../data/ui";
import { defaultLocale, htmlLang, locales, ogLocale, type Locale, type Localized } from "../data/i18n";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  alternates: Partial<Localized>;
  noindex?: boolean;
}

const { locale, title, description, alternates, noindex = false } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title === business.name ? title : `${title} | ${business.name}`;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: business.name,
  url: business.url,
  logo: new URL("/favicon.svg", site).href,
  email: business.email,
  telephone: business.phone.e164,
  areaServed: business.areaServed,
  sameAs: Object.values(business.social),
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    email: business.email,
    telephone: business.phone.e164,
    availableLanguage: ["French", "English"],
    hoursAvailable: {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: business.openingDays,
    },
  },
};
---

<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-inter-tight" preload />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex &&
      locales.map(
        (l) =>
          alternates[l] && <link rel="alternate" hreflang={htmlLang[l]} href={new URL(alternates[l], site).href} />,
      )}
    {!noindex && alternates[defaultLocale] && (
      <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLocale], site).href} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {/* Hero headline with the project ring, regenerated by hand when the headline changes. */}
    <meta property="og:image" content={new URL(`/og/home-${locale}.jpg`, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ui.shareImageAlt[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {/* Set before first paint so reveal targets start hidden only when scripts run. If the motion script has not
        started after 3s (failed, blocked or very slow), everything is shown as is. */}
    <script is:inline>
      {
        const root = document.documentElement;
        root.dataset.motion = "";
        setTimeout(() => root.dataset.motion !== "ready" && delete root.dataset.motion, 3000);
      }
    </script>
    {umami && (
      <>
        {/* Umami only receives campaign tags and the site's own fixed parameters, and referrers without their query. */}
        <script is:inline>
          window.umamiBeforeSend = (_type, payload) => {
            try {
              const keep = /^(utm_(source|medium|campaign|content|term)|plan|need|sent)$/;
              const url = new URL(payload.url, location.href);
              for (const key of [...url.searchParams.keys()]) if (!keep.test(key)) url.searchParams.delete(key);
              url.hash = "";
              payload.url = url.href;
              if (payload.referrer) {
                const referrer = new URL(payload.referrer, location.href);
                payload.referrer =
                  referrer.origin === location.origin ? referrer.pathname : referrer.origin + referrer.pathname;
              }
              return payload;
            } catch {
              return null;
            }
          };
        </script>
        <script
          is:inline
          defer
          src={umami.src}
          data-website-id={umami.websiteId}
          data-domains={new URL(business.url).hostname}
          data-do-not-track="true"
          data-before-send="umamiBeforeSend"
        ></script>
      </>
    )}
    <slot name="head" />
  </head>
  <body class="relative">
    <Header locale={locale} alternates={alternates} overlay={Astro.slots.has("full-width")} />
    <main id="content">
      <slot name="full-width" />
      <div class="site-width">
        <slot />
      </div>
    </main>
    <Footer locale={locale} />
    <script>
      import "lenis/dist/lenis.css";
      import { gsap, playWhileVisible, smoothScroll, withMotion } from "../lib/motion";
      import { initReveals } from "../lib/reveal";
      import { trackContactClicks } from "../lib/analytics";

      trackContactClicks();
      smoothScroll();
      initReveals();

      // Slow turn of the badge stars, only while they are on screen.
      withMotion(() => {
        gsap.utils.toArray<Element>("[data-spin]").forEach((star) => {
          const spin = gsap.to(star, {
            rotation: 360,
            transformOrigin: "50% 50%",
            duration: 8,
            ease: "none",
            repeat: -1,
          });
          playWhileVisible(star, spin);
        });
      });
      document.documentElement.dataset.motion = "ready";
    </script>
  </body>
</html>
