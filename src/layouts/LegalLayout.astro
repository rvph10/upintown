---
import Layout from "./Layout.astro";
import CallToAction from "../components/CallToAction.astro";
import PageHeader from "../components/PageHeader.astro";
import { htmlLang, type Locale } from "../data/i18n";
import { descriptions } from "../data/meta";
import { path, routes, type RouteId } from "../data/routes";
import { pageNames, ui } from "../data/ui";

interface Props {
  locale: Locale;
  route: Extract<RouteId, "legalNotice" | "privacy" | "terms">;
  /** ISO date of the last change. */
  updated: string;
}

const { locale, route, updated } = Astro.props;
const t = {
  label: { fr: "Légal", en: "Legal" },
  updated: { fr: "Mise à jour le", en: "Last updated" },
};
const updatedLabel = new Intl.DateTimeFormat(htmlLang[locale], { dateStyle: "long" }).format(new Date(updated));
---

{/* Shader header with title and date, the document on paper, then the contact call to action. */}
<Layout
  locale={locale}
  title={pageNames[route][locale]}
  description={descriptions[route][locale]}
  alternates={routes[route]}
>
  <PageHeader slot="full-width" label={t.label[locale]} title={pageNames[route][locale]} fadeTo="var(--color-paper)">
    <p class="mt-5 text-ui-lg text-ash-600">
      {t.updated[locale]} <time datetime={updated}>{updatedLabel}</time>
    </p>
  </PageHeader>

  <div slot="full-width" class="paper-fade-out pb-24 sm:pb-32">
    <div class="site-width">
      <article class="mx-auto max-w-3xl text-base leading-relaxed text-pretty text-ash-600 sm:text-lg [&_a]:font-medium [&_a]:text-iris-strong [&_a]:underline [&_a]:underline-offset-2 [&_a]:hover:text-ink [&_li]:mt-2 [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">
        <slot />
      </article>
    </div>
  </div>

  <CallToAction
    title={ui.ctaTitle[locale]}
    text={ui.ctaText[locale]}
    primary={{ href: path("contact", locale), label: ui.requestQuote[locale] }}
    call={ui.ctaCall[locale]}
  />
</Layout>
