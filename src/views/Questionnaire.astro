---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Checkmark from "../components/icons/Checkmark.astro";
import Info from "../components/icons/Info.astro";
import Lock from "../components/icons/Lock.astro";
import Pause from "../components/icons/Pause.astro";
import Plus from "../components/icons/Plus.astro";
import Button from "../components/ui/Button.astro";
import ChoiceField from "../components/ui/ChoiceField.astro";
import TextField from "../components/ui/TextField.astro";
import { business } from "../data/business";
import type { Locale } from "../data/i18n";
import { descriptions, titles } from "../data/meta";
import { answerLimit, questionnaire, type Question } from "../data/questionnaire";
import { path, routes } from "../data/routes";
import type { FieldError } from "../lib/contact";
import type { QuestionnaireState } from "../lib/questionnaire";

interface Props extends QuestionnaireState {
  locale: Locale;
}

const { locale, answers, errors, status, token } = Astro.props;

const t = {
  label: { fr: "Questionnaire", en: "Questionnaire" },
  title: { fr: "Votre entreprise, en quelques réponses.", en: "Your business, in a few answers." },
  beforeTitle: { fr: "Avant de commencer", en: "Before you start" },
  sections: { fr: "Sections", en: "Sections" },
  answered: { fr: "répondu", en: "answered" },
  submit: { fr: "Envoyer mes réponses", en: "Send my answers" },
  privacy: {
    fr: "Vos réponses servent uniquement à préparer votre projet.",
    en: "Your answers are only used to prepare your project.",
  },
  privacyLink: { fr: "Politique de confidentialité", en: "Privacy policy" },
  saved: { fr: "Brouillon enregistré sur cet appareil.", en: "Draft saved on this device." },
  invalid: {
    fr: "Certaines réponses sont à compléter. Elles sont signalées en rouge.",
    en: "Some answers need attention. They are marked in red.",
  },
  sentTitle: { fr: "Questionnaire envoyé.", en: "Questionnaire sent." },
  sent: {
    fr: "Merci. Un e-mail de confirmation vient de vous être envoyé. Vos réponses seront reprises ensemble pendant l'appel d'analyse.",
    en: "Thank you. A confirmation email is on its way. Your answers will be gone through together during the analysis call.",
  },
  backHome: { fr: "Retour à l'accueil", en: "Back to home" },
  failed: {
    fr: `Les réponses n'ont pas pu être envoyées. Elles sont toujours là : réessayez, ou écrivez à ${business.email}.`,
    en: `Your answers could not be sent. They are still here: try again, or write to ${business.email}.`,
  },
  limited: {
    fr: `Trop d'envois depuis cette connexion. Écrivez à ${business.email}.`,
    en: `Too many submissions from this connection. Write to ${business.email}.`,
  },
};

const before = [
  {
    Icon: Info,
    title: { fr: "Seul l'essentiel est obligatoire", en: "Only the essentials are required" },
    text: {
      fr: "Les questions marquées d'un point. Si une autre ne vous parle pas, laissez-la vide : on en parlera pendant l'appel.",
      en: "The questions marked with a dot. If another one doesn't fit, leave it empty: it will come up during the call.",
    },
  },
  {
    Icon: Pause,
    title: { fr: "Faites une pause quand vous voulez", en: "Take a break any time" },
    text: {
      fr: "Vos réponses restent sur cet appareil, dans ce navigateur, jusqu'à l'envoi.",
      en: "Your answers stay on this device, in this browser, until you send them.",
    },
  },
  {
    Icon: Plus,
    title: { fr: "Vos fichiers à part", en: "Your files separately" },
    text: {
      fr: "Logo, photos et documents vont dans le dossier partagé dont vous avez reçu le lien.",
      en: "Logo, photos and documents go in the shared folder you received a link to.",
    },
  },
  {
    Icon: Lock,
    title: { fr: "Jamais de mot de passe", en: "Never a password" },
    text: {
      fr: "Les accès (domaine, e-mail, Google) sont organisés pendant l'appel.",
      en: "Access (domain, email, Google) is arranged during the call.",
    },
  },
];

const errorText: Record<FieldError, { fr: string; en: string }> = {
  required: { fr: "Cette réponse est obligatoire.", en: "This answer is required." },
  invalid: { fr: "Cette adresse e-mail n'est pas valide.", en: "This email address is not valid." },
  tooLong: { fr: "Ce texte est trop long.", en: "This text is too long." },
};
const message = (question: Question) => {
  const error = errors[question.id];
  return error && errorText[error][locale];
};
const hasErrors = Object.keys(errors).length > 0;

// Short answers sit two per row; long answers and choices take the full row. A short answer left alone in its row
// takes the full row too, so no row ends with an empty half.
const isWide = (questions: readonly Question[], index: number) => {
  const isShort = (q?: Question) => q !== undefined && q.kind !== "long" && q.kind !== "choice";
  if (!isShort(questions[index])) return true;
  let start = index;
  while (isShort(questions[start - 1])) start--;
  return (index - start) % 2 === 0 && !isShort(questions[index + 1]);
};

const card = "rounded-card bg-surface p-6 inset-ring inset-ring-ash-200 sm:p-8";
const alert = "rounded-3xl bg-surface p-6 text-base font-medium text-danger-strong inset-ring-2 inset-ring-danger";
const number =
  "grid size-8 flex-none place-items-center rounded-full bg-ink text-sm font-semibold text-paper tabular-nums";
---

<Layout
  locale={locale}
  title={titles.questionnaire[locale]}
  description={descriptions.questionnaire[locale]}
  alternates={routes.questionnaire}
  noindex
>
  <PageHeader
    slot="full-width"
    label={t.label[locale]}
    title={t.title[locale]}
    subtitle={descriptions.questionnaire[locale]}
    fadeTo="var(--color-paper)"
  />

  <div slot="full-width" class="paper-fade-out pb-24 sm:pb-32">
    {status === "sent" ? (
      <div class="site-width">
        <section
          role="status"
          aria-labelledby="sent-title"
          data-questionnaire-sent
          class:list={[card, "mx-auto flex max-w-3xl flex-col items-center justify-center py-16 text-center sm:py-20"]}
        >
          <span class="grid size-16 place-items-center rounded-full bg-volt-soft text-volt-strong">
            <Checkmark class="size-8 [--check:var(--color-volt-soft)]" />
          </span>
          <h2 id="sent-title" class="mt-6 text-3xl font-semibold tracking-title text-ink">
            {t.sentTitle[locale]}
          </h2>
          <p class="mt-3 max-w-md text-lg leading-relaxed text-pretty text-ash-600">{t.sent[locale]}</p>
          <Button href={path("home", locale)} size="lg" tone="surface" class="mt-8">
            {t.backHome[locale]}
          </Button>
        </section>
      </div>
    ) : (
      <div class="site-width grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-8">
        <form
          method="post"
          novalidate
          data-questionnaire
          data-restore={status === "idle" && !hasErrors ? "" : undefined}
          class="grid gap-6"
        >
          {hasErrors && (
            <p role="alert" class={alert}>
              {t.invalid[locale]}
            </p>
          )}
          {status === "failed" && (
            <p role="alert" class={alert}>
              {t.failed[locale]}
            </p>
          )}
          {status === "limited" && (
            <p role="alert" class={alert}>
              {t.limited[locale]}
            </p>
          )}

          <section aria-labelledby="before-title" class={card}>
            <h2 id="before-title" class="text-2xl font-semibold tracking-title text-ink">
              {t.beforeTitle[locale]}
            </h2>
            <ul class="mt-6 grid gap-3 sm:grid-cols-2">
              {before.map(({ Icon, title, text }) => (
                <li class="flex gap-4 rounded-3xl bg-paper p-5">
                  <span class="grid size-10 flex-none place-items-center rounded-xl bg-surface text-ink">
                    <Icon class="size-5" />
                  </span>
                  <span class="grid gap-1">
                    <span class="font-medium text-ink">{title[locale]}</span>
                    <span class="text-base leading-relaxed text-ash-600">{text[locale]}</span>
                  </span>
                </li>
              ))}
            </ul>
          </section>

          {questionnaire.map((section, index) => (
            <section
              id={section.id}
              aria-labelledby={`${section.id}-title`}
              data-section
              class:list={[card, "scroll-mt-28"]}
            >
              <div class="flex items-start gap-4">
                <span class:list={[number, "mt-0.5"]}>{index + 1}</span>
                <div class="grid gap-2">
                  <h2 id={`${section.id}-title`} class="text-2xl font-semibold tracking-title text-ink">
                    {section.title[locale]}
                  </h2>
                  {section.intro && (
                    <p class="text-base leading-relaxed text-pretty text-ash-600">{section.intro[locale]}</p>
                  )}
                </div>
              </div>
              <div class="mt-8 grid gap-8 sm:grid-cols-2">
                {section.questions.map((question, position, all) =>
                  question.kind === "choice" ? (
                    <ChoiceField
                      id={question.id}
                      label={question.label[locale]}
                      options={(question.options ?? []).map((option) => ({
                        value: option.value,
                        label: option.label[locale],
                      }))}
                      value={answers[question.id]}
                      required={question.required}
                      hint={question.hint?.[locale]}
                      error={message(question)}
                      class="sm:col-span-2"
                    />
                  ) : (
                    <TextField
                      id={question.id}
                      label={question.label[locale]}
                      type={question.kind === "long" ? undefined : question.kind}
                      multiline={question.kind === "long"}
                      rows={question.rows}
                      placeholder={question.placeholder?.[locale]}
                      autocomplete={question.autocomplete}
                      required={question.required}
                      maxlength={String(answerLimit(question))}
                      value={answers[question.id]}
                      hint={question.hint?.[locale]}
                      error={message(question)}
                      class={isWide(all, position) ? "sm:col-span-2" : undefined}
                    />
                  ),
                )}
              </div>
            </section>
          ))}

          <div hidden>
            <label for="fax">Fax</label>
            <input id="fax" name="fax" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="token" value={token} />

          <div class:list={[card, "flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-8"]}>
            <div class="grid gap-1 px-1 text-sm leading-snug text-ash-600">
              <p data-draft-status hidden class="font-medium text-ink">
                {t.saved[locale]}
              </p>
              <p class="max-w-sm">
                {t.privacy[locale]}{" "}
                <a
                  href={path("privacy", locale)}
                  class="font-medium text-iris-strong underline underline-offset-2 hover:text-ink"
                >
                  {t.privacyLink[locale]}
                </a>
              </p>
            </div>
            <Button type="submit" size="lg" class="self-start sm:self-auto" data-submit>
              {t.submit[locale]}
            </Button>
          </div>
        </form>

        <aside class="hidden lg:sticky lg:top-28 lg:block">
          <nav aria-labelledby="sections-title" class={card}>
            <h2 id="sections-title" class="text-2xl font-semibold tracking-title text-ink">
              {t.sections[locale]}
            </h2>
            <ol class="mt-6 grid gap-1">
              {questionnaire.map((section, index) => (
                <li>
                  <a
                    href={`#${section.id}`}
                    data-section-link={section.id}
                    class="group -mx-3 flex items-center gap-3 rounded-2xl p-3 transition-colors duration-300 hover:bg-paper focus-visible:bg-paper focus-visible:outline-2 focus-visible:outline-iris-strong motion-reduce:transition-none"
                  >
                    <span
                      data-section-number
                      class:list={[
                        number,
                        "transition-colors duration-300 data-done:bg-volt data-done:text-ink motion-reduce:transition-none",
                      ]}
                    >
                      {index + 1}
                    </span>
                    <span class="min-w-0 flex-1 font-medium text-ink">{section.title[locale]}</span>
                    <span data-section-count hidden class="text-sm text-ash-600 tabular-nums">
                      <span data-count-value></span>
                      <span class="sr-only">{t.answered[locale]}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      </div>
    )}
  </div>
</Layout>

<script>
  // Draft in this browser only, under one key for both languages: the field names are the same.
  const key = "upintown-questionnaire";
  const form = document.querySelector<HTMLFormElement>("[data-questionnaire]");

  const storage = {
    read(): Record<string, string> | null {
      try {
        return JSON.parse(localStorage.getItem(key) ?? "null");
      } catch {
        return null;
      }
    },
    write(values: Record<string, string>) {
      try {
        localStorage.setItem(key, JSON.stringify(values));
        return true;
      } catch {
        return false;
      }
    },
    clear() {
      try {
        localStorage.removeItem(key);
      } catch {}
    },
  };

  if (document.querySelector("[data-questionnaire-sent]")) storage.clear();

  if (form) {
    const fields = () =>
      [...form.elements].filter(
        (el): el is HTMLInputElement | HTMLTextAreaElement =>
          (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) &&
          !["token", "fax"].includes(el.name) &&
          el.type !== "hidden",
      );

    // A fresh form takes the saved draft. After a failed send the server already shows what was typed.
    const draft = storage.read();
    if (draft && form.hasAttribute("data-restore")) {
      for (const field of fields()) {
        const value = draft[field.name];
        if (value === undefined) continue;
        if (field instanceof HTMLInputElement && field.type === "radio") field.checked = field.value === value;
        else field.value = value;
      }
    }

    const status = form.querySelector<HTMLElement>("[data-draft-status]");
    let timer: number | undefined;
    function save() {
      const values: Record<string, string> = {};
      for (const [name, value] of new FormData(form!)) {
        if (name !== "token" && name !== "fax") values[name] = String(value);
      }
      if (storage.write(values) && status) status.hidden = false;
    }

    // Answered questions per section, shown in the side navigation.
    const sections = [...form.querySelectorAll<HTMLElement>("[data-section]")];
    function updateProgress() {
      for (const section of sections) {
        const names = new Set(
          [...section.querySelectorAll<HTMLInputElement>("input[name], textarea[name]")].map((el) => el.name),
        );
        const data = new FormData(form!);
        const answered = [...names].filter((name) => String(data.get(name) ?? "").trim()).length;
        const link = document.querySelector(`[data-section-link="${section.id}"]`);
        const count = link?.querySelector<HTMLElement>("[data-section-count]");
        const value = link?.querySelector<HTMLElement>("[data-count-value]");
        if (count && value) {
          value.textContent = `${answered}/${names.size}`;
          count.hidden = false;
        }
        link?.querySelector("[data-section-number]")?.toggleAttribute("data-done", answered === names.size);
      }
    }
    updateProgress();

    form.addEventListener("input", () => {
      clearTimeout(timer);
      timer = window.setTimeout(save, 400);
      updateProgress();
    });

    // One click sends: the button is disabled while the page submits, and enabled again if the client comes back.
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    form.addEventListener("submit", () => {
      clearTimeout(timer);
      save();
      if (!submit) return;
      submit.disabled = true;
      submit.setAttribute("aria-busy", "true");
    });
    addEventListener("pageshow", () => {
      if (!submit) return;
      submit.disabled = false;
      submit.removeAttribute("aria-busy");
    });

    // After a failed submit, put the cursor in the first answer to fix. Its error is read out with it.
    form.querySelector<HTMLElement>('[aria-invalid="true"]:not([hidden])')?.focus();
  }
</script>
