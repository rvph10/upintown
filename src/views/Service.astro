---
import Layout from "../layouts/Layout.astro";
import { formatPrice, type Locale } from "../data/i18n";
import { descriptions } from "../data/meta";
import { services } from "../data/offer";
import { path, routes } from "../data/routes";
import { pageNames, ui } from "../data/ui";

interface Props {
  locale: Locale;
  id: (typeof services)[number]["id"];
}

const { locale, id } = Astro.props;
const service = services.find((s) => s.id === id)!;
---

<Layout
  locale={locale}
  title={service.name[locale]}
  description={descriptions[service.route][locale]}
  alternates={routes[service.route]}
>
  <h1>{service.name[locale]}</h1>
  <p>{descriptions[service.route][locale]}</p>
  <p>
    {ui.from[locale]} {formatPrice(service.fromPrice, locale)}
    {service.monthly && ui.perMonth[locale]}
  </p>
  <p>
    <a href={path("contact", locale)}>{ui.requestQuote[locale]}</a>
    <a href={path("pricing", locale)}>{pageNames.pricing[locale]}</a>
  </p>
</Layout>
