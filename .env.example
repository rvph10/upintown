RESEND_API_KEY=
# Self-hosted Umami, needed at build time. Leave empty to build without statistics.
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=
# Holo blog webhook. Shared secret from Holo (HMAC mode), a fine-grained GitHub token limited to this repo
# (Contents: read and write, nothing else), and the repo as owner/name.
HOLO_WEBHOOK_SECRET=
HOLO_GITHUB_TOKEN=
HOLO_GITHUB_REPO=rvph10/upintown
